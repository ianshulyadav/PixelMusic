<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow querying Snapchat and Instagram for story sharing -->
    <queries>
        <package android:name="com.snapchat.android" />
        <package android:name="com.instagram.android" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- MANAGE_EXTERNAL_STORAGE removed for Google Play compliance.
         Write access to individual files is obtained via MediaStore.createWriteRequest(). -->
    <!-- Required only on Android 11 and below for legacy Bluetooth discovery and Wi-Fi SSID access. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <!-- For disabling battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".PixelMusicApplication"
        android:allowBackup="true"
        android:appCategory="audio"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelMusic"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PixelMusic"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.unshoo.pixelmusic.action.OPEN_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Open YouTube / YouTube Music links in PixelMusic -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.youtube.com" />
                <data android:scheme="https" android:host="www.youtube.com" />
                <data android:scheme="https" android:host="youtube.com" />
                <data android:scheme="https" android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="music.youtube.com" />
                <data android:scheme="http" android:host="www.youtube.com" />
                <data android:scheme="http" android:host="youtube.com" />
                <data android:scheme="http" android:host="youtu.be" />
            </intent-filter>
            <!-- Open M3U/M3U8 playlists shared from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="content" android:mimeType="audio/mpegurl" />
                <data android:scheme="content" android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- App Launcher Icon Aliases -->
        <activity-alias
            android:name=".MainActivityBluePurple"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:theme="@style/Theme.App.Starting.BluePurple"
            android:icon="@mipmap/ic_launcher_blue_purple"
            android:roundIcon="@mipmap/ic_launcher_blue_purple_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBabyPinkPurple"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@style/Theme.App.Starting.BabyPinkPurple"
            android:icon="@mipmap/ic_launcher_baby_pink_purple"
            android:roundIcon="@mipmap/ic_launcher_baby_pink_purple_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityGraphite"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@style/Theme.App.Starting.Graphite"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityOrangeYellow"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@style/Theme.App.Starting.OrangeYellow"
            android:icon="@mipmap/ic_launcher_orange_yellow"
            android:roundIcon="@mipmap/ic_launcher_orange_yellow_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLimeGreen"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@style/Theme.App.Starting.LimeGreen"
            android:icon="@mipmap/ic_launcher_lime_green"
            android:roundIcon="@mipmap/ic_launcher_lime_green_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLimeLemon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@style/Theme.App.Starting.LimeLemon"
            android:icon="@mipmap/ic_launcher_lime_lemon"
            android:roundIcon="@mipmap/ic_launcher_lime_lemon_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".presentation.telegram.auth.TelegramLoginActivity"
            android:exported="false"
            android:label="Telegram Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.netease.auth.NeteaseLoginActivity"
            android:exported="false"
            android:label="Netease Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.gdrive.auth.GDriveLoginActivity"
            android:exported="false"
            android:label="Google Drive Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.qqmusic.auth.QqMusicLoginActivity"
            android:exported="false"
            android:label="QQ Music Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.navidrome.auth.NavidromeLoginActivity"
            android:exported="false"
            android:label="Navidrome Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.jellyfin.auth.JellyfinLoginActivity"
            android:exported="false"
            android:label="Jellyfin Login"
            android:theme="@style/Theme.PixelMusic"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".ExternalPlayerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PixelMusic.ExternalPlayer"
            android:excludeFromRecents="true"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="audio/*" />
                <data android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.MusicService"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name=".ui.glancewidget.PixelMusicGlanceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixelmusic_glance_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.BarWidget4x1Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bar_widget_4x1_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.ControlWidget4x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/control_widget_4x2_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.GridWidget2x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_widget_2x2_info" />
        </receiver>

        <receiver android:name=".data.service.SleepTimerReceiver" android:exported="false" />

        <!-- Download cancel button in download progress notifications -->
        <receiver
            android:name=".data.remote.youtube.DownloadCancelReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.unshoo.pixelmusic.DOWNLOAD_CANCEL" />
            </intent-filter>
        </receiver>

        <!-- Media Button Receiver for external media controls (headphones, car, etc.) -->
        <receiver
            android:name=".data.service.PixelMusicMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- *** AÑADE ESTE BLOQUE PARA DESHABILITAR EL INICIALIZADOR POR DEFECTO *** -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Esto evita que el inicializador de WorkManager se ejecute automáticamente -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver android:name=".ui.glancewidget.WidgetUpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.unshoo.pixelmusic.ACTION_WIDGET_UPDATE_PLAYBACK_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.service.http.MediaFileHttpServerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service
            android:name=".data.service.wear.WatchTransferForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.unshoo.pixelmusic.data.service.cast.CastOptionsProvider" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="com.unshoo.pixelmusic.data.provider.SnapFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name=".data.provider.SharedArtworkContentProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />


        <!-- Quick Settings Tiles -->
        <service
            android:name=".data.service.tile.ShuffleAllTileService"
            android:exported="true"
            android:label="@string/tile_shuffle_all"
            android:icon="@drawable/ic_shortcut_shuffle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".data.service.tile.LastPlaylistTileService"
            android:exported="true"
            android:label="@string/tile_last_playlist"
            android:icon="@drawable/ic_shortcut_playlist"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <meta-data
            android:name="com.snapchat.kit.sdk.clientId"
            android:value="cb161c07-2ed5-4064-87b0-f8dedf684849" />

        <meta-data
            android:name="com.snap.kit.clientId"
            android:value="cb161c07-2ed5-4064-87b0-f8dedf684849" />

    </application>

</manifest>
